# Hugging Face cache (must be set before transformers/diffusers/sentence-transformers import)
HF_HOME=D:/huggingface_cache
HUGGINGFACE_HUB_CACHE=D:/huggingface_cache/hub
TRANSFORMERS_CACHE=D:/huggingface_cache/transformers

# Ollama
# Client URL. Windows Ollama often sets OLLAMA_HOST=0.0.0.0 (bind address);
# the app normalizes that to http://127.0.0.1:11434.
OLLAMA_HOST=http://127.0.0.1:11434
LLM_MODEL=qwen3.5:9b-16k
LLM_NUM_CTX=8192
LLM_KEEP_ALIVE=5m

# Qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=library_chunks

# RAG embeddings (CPU, weights in HF_HOME)
EMBED_MODEL=BAAI/bge-m3
RAG_CHUNK_CHARS=2400
RAG_CHUNK_OVERLAP=400
RAG_TOP_K=10
RAG_EMBED_BATCH=8

# Services
AI_SERVICE_URL=http://127.0.0.1:8000
NEST_PORT=3000

# SQLite (path relative to backend/prisma)
DATABASE_URL=file:../../data/sqlite/app.db

# MinIO (compose only on stage 0; storage driver later)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://127.0.0.1:9000

# GPU / Flux (used from stage 2)
GPU_FREE_MB_THRESHOLD=500
FLUX_MODEL_ID=black-forest-labs/FLUX.1-dev
FLUX_QUANT=nf4
# FLUX_MODEL_PATH=
